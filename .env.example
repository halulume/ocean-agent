# Pacifica 계정 주소 (지갑 주소, 공개돼도 안전한 값). 메인넷용.
ADDRESS=

# 테스트넷용 지갑 주소 (선택), 테스트넷에서 다른 지갑을 쓸 때.
# config.yaml이 테스트넷이면 이 주소가 우선 사용됨. 없으면 위 ADDRESS로 폴백.
ADDRESS_TESTNET=

# Pacifica API 키, app.pacifica.fi/apikey 에서 "생성" 누르면 나오는 긴 문자열
# 조회만 할 때는 비워둬도 됨. 거래(주문)할 때만 필요.
# 이 키는 거래 전용이라 지갑 자산은 못 건드리고, 같은 페이지에서 언제든 폐기 가능.
# (메인넷용, config.yaml이 메인넷일 때 사용)
PACIFICA_API_KEY=

# 테스트넷용 API 키 (선택), 에이전트 키는 네트워크마다 따로 승인되므로,
# 테스트넷에서 별도 발급했다면 여기에. config.yaml이 테스트넷이면 이 키가 우선 사용됨.
# (양쪽에서 같은 키를 승인했다면 위 PACIFICA_API_KEY 하나만 넣어도 됨)
PACIFICA_API_KEY_TESTNET=

# 텔레그램 알림 (@BotFather에서 봇 생성)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
